ADMIN_USERNAME=change-me
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Optional precomputed PBKDF2-SHA256 hash instead of ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=pbkdf2_sha256$600000$salt$digest
# Legacy scrypt hashes require an approved reset before running on Workers.
ADMIN_NAME=Admin
ADMIN_IDLE_MINUTES=15
FRONTEND_ORIGIN=http://localhost:5173
